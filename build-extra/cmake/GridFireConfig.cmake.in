# GridFire package configuration for CMake's find_package. Generated by GridFire's Meson build; relocatable (every
# path is relative to this file).
#
#   find_package(GridFire 1.2 REQUIRED)                       # or: COMPONENTS CXX C Fortran
#   target_link_libraries(app PRIVATE GridFire::gridfire)          # C++ library (C++23)
#   target_link_libraries(app PRIVATE GridFire::gridfire_extern)   # C API: #include "gridfire/extern/gridfire_extern.h"
#   target_link_libraries(app PRIVATE GridFire::gridfire_fortran)  # Fortran: `use gridfire_mod`
#
# For a wheel install (pip install gridfire), point CMake at it with
#   cmake -DCMAKE_PREFIX_PATH="$(gf-config --cmake-prefix)" ...
#
# The Fortran module ships as source (a compiled .mod only works with the compiler version that wrote it), so
# GridFire::gridfire_fortran compiles it with your project's Fortran compiler. It exists only if the Fortran language
# is enabled before find_package; otherwise compile ${GridFire_FORTRAN_SOURCE} yourself and link
# GridFire::gridfire_extern.
#
# Components: CXX (GridFire::gridfire), C (GridFire::gridfire_extern) and Fortran (GridFire::gridfire_fortran). With no
# COMPONENTS, every target this installation and project can provide is defined.
#
# Variables: GridFire_VERSION, GridFire_PREFIX, GridFire_INCLUDE_DIR, GridFire_LIBRARY_DIR, GridFire_FORTRAN_SOURCE.

if(CMAKE_VERSION VERSION_LESS 3.21)
    set(GridFire_FOUND FALSE)
    set(GridFire_NOT_FOUND_MESSAGE "GridFire needs CMake 3.21 or newer (found ${CMAKE_VERSION})")
    return()
endif()

set(GridFire_VERSION "@GF_VERSION@")
# "wheel": installed by the gridfire Python wheel, with fourdst in the fourdst wheel next to it.
# "install": a meson install; fourdst is looked for next to GridFire first, then in CMake's usual places.
set(_gf_layout "@GF_LAYOUT@")

function(_gf_resolve out base path)
    if(IS_ABSOLUTE "${path}")
        set(_p "${path}")
    else()
        set(_p "${base}/${path}")
    endif()
    get_filename_component(_p "${_p}" ABSOLUTE)
    set(${out} "${_p}" PARENT_SCOPE)
endfunction()

_gf_resolve(GridFire_PREFIX "${CMAKE_CURRENT_LIST_DIR}" "@GF_PREFIX_FROM_CMAKEDIR@")
_gf_resolve(GridFire_INCLUDE_DIR "${GridFire_PREFIX}" "@GF_INCLUDEDIR@")
_gf_resolve(GridFire_LIBRARY_DIR "${GridFire_PREFIX}" "@GF_LIBDIR@")
_gf_resolve(GridFire_FORTRAN_SOURCE "${GridFire_PREFIX}" "@GF_FORTRAN_SOURCE@")
_gf_resolve(_gf_fourdst_prefix "${GridFire_PREFIX}" "@GF_FOURDST_PREFIX@")
_gf_resolve(_gf_fourdst_libdir "${_gf_fourdst_prefix}" "@GF_FOURDST_LIBDIR@")
_gf_resolve(_gf_fourdst_vendor_libdir "${_gf_fourdst_prefix}" "@GF_FOURDST_VENDOR_LIBDIR@")
_gf_resolve(_gf_fourdst_includedir "${_gf_fourdst_prefix}" "@GF_FOURDST_INCLUDEDIR@")
if(NOT EXISTS "${GridFire_FORTRAN_SOURCE}")
    unset(GridFire_FORTRAN_SOURCE)
endif()

set(GridFire_FOUND TRUE)
set(_gf_missing "")

# Imported targets are directory-scoped unless global; GridFire's own CMakeLists.txt (FetchContent) asks for global ones
# so that the project that fetched it can see them.
if(GridFire_IMPORT_GLOBAL)
    set(_gf_global GLOBAL)
else()
    set(_gf_global "")
endif()

# Include directories as -I, not CMake's default -isystem for imported targets: Apple clang searches /usr/local/include
# before every -isystem directory, so an older GridFire installed there would shadow these headers.
function(_gf_not_system target)
    if(CMAKE_VERSION VERSION_LESS 3.25)
        set_target_properties(${target} PROPERTIES IMPORTED_NO_SYSTEM TRUE)
    else()
        set_target_properties(${target} PROPERTIES SYSTEM FALSE)
    endif()
endfunction()

function(_gf_find_library out name)
    if(_gf_layout STREQUAL "wheel")
        set(_mode NO_DEFAULT_PATH)
    else()
        set(_mode "")
    endif()
    find_library(${out} NAMES ${name} HINTS ${ARGN} ${_mode} NO_CACHE)
    set(${out} "${${out}}" PARENT_SCOPE)
endfunction()

# --- C++ library: GridFire::gridfire ------------------------------------------------------------------------------
if(NOT TARGET GridFire::gridfire)
    _gf_find_library(_gf_lib gridfire "${GridFire_LIBRARY_DIR}")
    set(_gf_fourdst_targets "")
    set(_gf_ok TRUE)
    if(NOT _gf_lib)
        set(_gf_ok FALSE)
        list(APPEND _gf_missing "libgridfire in ${GridFire_LIBRARY_DIR}")
    elseif(_gf_lib MATCHES "\\.(a|lib)$")
        # A static libgridfire needs every private dependency (SUNDIALS, mimalloc, OpenMP, ...); use pkg-config
        set(_gf_ok FALSE)
        list(APPEND _gf_missing "a shared libgridfire (found the static ${_gf_lib}; use pkg-config for static builds)")
    endif()
    # fourdst: the libraries GridFire's public headers use, and their headers
    foreach(_gf_dep IN ITEMS composition logging const reflect_cpp)
        _gf_find_library(_gf_dep_lib ${_gf_dep} "${_gf_fourdst_libdir}" "${_gf_fourdst_vendor_libdir}")
        if(NOT _gf_dep_lib)
            set(_gf_ok FALSE)
            list(APPEND _gf_missing "fourdst library ${_gf_dep} (looked in ${_gf_fourdst_libdir})")
            continue()
        endif()
        if(NOT TARGET GridFire::fourdst_${_gf_dep})
            if(_gf_dep_lib MATCHES "\\.(a|lib)$")
                add_library(GridFire::fourdst_${_gf_dep} STATIC IMPORTED ${_gf_global})
            else()
                add_library(GridFire::fourdst_${_gf_dep} SHARED IMPORTED ${_gf_global})
            endif()
            set_target_properties(GridFire::fourdst_${_gf_dep} PROPERTIES IMPORTED_LOCATION "${_gf_dep_lib}")
        endif()
        list(APPEND _gf_fourdst_targets GridFire::fourdst_${_gf_dep})
    endforeach()
    if(_gf_layout STREQUAL "wheel")
        find_path(_gf_fourdst_inc NAMES fourdst/composition/composition.h HINTS "${_gf_fourdst_includedir}"
                  NO_DEFAULT_PATH NO_CACHE)
    else()
        find_path(_gf_fourdst_inc NAMES fourdst/composition/composition.h HINTS "${_gf_fourdst_includedir}" NO_CACHE)
    endif()
    if(NOT _gf_fourdst_inc)
        set(_gf_ok FALSE)
        list(APPEND _gf_missing "fourdst headers (looked in ${_gf_fourdst_includedir})")
    endif()
    if(_gf_ok)
        add_library(GridFire::gridfire SHARED IMPORTED ${_gf_global})
        set_target_properties(GridFire::gridfire PROPERTIES
            IMPORTED_LOCATION "${_gf_lib}"
            INTERFACE_INCLUDE_DIRECTORIES
                "${GridFire_INCLUDE_DIR};${GridFire_INCLUDE_DIR}/gridfire/vendor;${_gf_fourdst_inc};${_gf_fourdst_inc}/fourdst/vendor"
            INTERFACE_LINK_LIBRARIES "${_gf_fourdst_targets}"
            INTERFACE_COMPILE_FEATURES cxx_std_23)
        _gf_not_system(GridFire::gridfire)
    endif()
endif()
set(GridFire_CXX_FOUND FALSE)
if(TARGET GridFire::gridfire)
    set(GridFire_CXX_FOUND TRUE)
endif()

# --- C API: GridFire::gridfire_extern -----------------------------------------------------------------------------
if(NOT TARGET GridFire::gridfire_extern AND EXISTS "${GridFire_INCLUDE_DIR}/gridfire/extern/gridfire_extern.h")
    _gf_find_library(_gf_extern_lib gridfire_extern "${GridFire_LIBRARY_DIR}")
    if(_gf_extern_lib)
        add_library(GridFire::gridfire_extern SHARED IMPORTED ${_gf_global})
        set_target_properties(GridFire::gridfire_extern PROPERTIES
            IMPORTED_LOCATION "${_gf_extern_lib}"
            INTERFACE_INCLUDE_DIRECTORIES "${GridFire_INCLUDE_DIR}")
        _gf_not_system(GridFire::gridfire_extern)
        # libgridfire_extern loads libgridfire and fourdst through its own run-time paths; listing them here lets CMake
        # pass -rpath-link for linkers that resolve indirect dependencies at link time (GNU ld)
        if(TARGET GridFire::gridfire)
            set_target_properties(GridFire::gridfire_extern PROPERTIES
                IMPORTED_LINK_DEPENDENT_LIBRARIES "GridFire::gridfire;${_gf_fourdst_targets}")
        endif()
    else()
        list(APPEND _gf_missing "libgridfire_extern in ${GridFire_LIBRARY_DIR}")
    endif()
endif()
set(GridFire_C_FOUND FALSE)
if(TARGET GridFire::gridfire_extern)
    set(GridFire_C_FOUND TRUE)
endif()

# --- Fortran module: GridFire::gridfire_fortran, compiled with the project's Fortran compiler -----------------------
if(NOT TARGET GridFire::gridfire_fortran AND TARGET GridFire::gridfire_extern AND GridFire_FORTRAN_SOURCE
   AND CMAKE_Fortran_COMPILER_LOADED)
    set(_gf_moddir "${CMAKE_CURRENT_BINARY_DIR}/gridfire_fortran_modules")
    add_library(gridfire_fortran_module STATIC EXCLUDE_FROM_ALL "${GridFire_FORTRAN_SOURCE}")
    set_target_properties(gridfire_fortran_module PROPERTIES
        Fortran_MODULE_DIRECTORY "${_gf_moddir}"
        POSITION_INDEPENDENT_CODE ON)
    target_include_directories(gridfire_fortran_module PUBLIC "$<BUILD_INTERFACE:${_gf_moddir}>")
    target_link_libraries(gridfire_fortran_module PUBLIC GridFire::gridfire_extern)
    add_library(GridFire::gridfire_fortran ALIAS gridfire_fortran_module)
endif()
set(GridFire_Fortran_FOUND FALSE)
if(TARGET GridFire::gridfire_fortran)
    set(GridFire_Fortran_FOUND TRUE)
endif()

# --- Requested components -------------------------------------------------------------------------------------------
foreach(_gf_comp IN LISTS GridFire_FIND_COMPONENTS)
    if(NOT _gf_comp MATCHES "^(CXX|C|Fortran)$")
        set(GridFire_FOUND FALSE)
        set(GridFire_NOT_FOUND_MESSAGE "Unknown GridFire component ${_gf_comp}; expected CXX, C or Fortran")
    elseif(GridFire_FIND_REQUIRED_${_gf_comp} AND NOT GridFire_${_gf_comp}_FOUND)
        set(GridFire_FOUND FALSE)
        if(_gf_comp STREQUAL "Fortran" AND GridFire_C_FOUND)
            set(GridFire_NOT_FOUND_MESSAGE
                "GridFire component Fortran needs the Fortran language enabled before find_package(GridFire)")
        else()
            set(GridFire_NOT_FOUND_MESSAGE "GridFire component ${_gf_comp} is not available. Missing: ${_gf_missing}")
        endif()
    endif()
endforeach()
if(NOT GridFire_FIND_COMPONENTS AND NOT GridFire_CXX_FOUND AND NOT GridFire_C_FOUND)
    set(GridFire_FOUND FALSE)
    set(GridFire_NOT_FOUND_MESSAGE "No usable GridFire library under ${GridFire_PREFIX}. Missing: ${_gf_missing}")
endif()
